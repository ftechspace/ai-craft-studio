diff --git a/apps/filmcraft-cli/examples/contact.rs b/apps/filmcraft-cli/examples/contact.rs
new file mode 100644
index 00000000..8b6214de
--- /dev/null
+++ b/apps/filmcraft-cli/examples/contact.rs
@@ -0,0 +1,116 @@
+//! Contact sheets and levels for looking at footage (used by the film-editor agent). JPEG grids, 5 columns,
+//! row-major, 384×216 cells. `<out>` is a directory, or a `.jpg` path for the range/program modes.
+//!
+//! `contact <out> <max_frames> <file>...`               one sheet per clip, frames spread evenly (≥1 per 2 s)
+//! `contact <out> range <file> <from> <to> <step>`      one sheet of a source range (seconds), up to 60 frames
+//! `contact <out> program <project.fcproj> <seconds>...` the project's active sequence at those times
+//! `contact <out.png> frame <file> <seconds>`           one full-resolution frame of a clip (PNG/JPEG by extension)
+//!
+//! Prints one JSON line per sheet: the sheet path, the times, and per-frame levels — luma percentiles
+//! (2/50/98 %, Rec.709, 0–100) and mean RGB (0–255) — a numeric stand-in for the waveform.
+
+use filmcraft_engine::Session;
+use filmcraft_time::Tick;
+use serde_json::{Value, json};
+
+const TPS: f64 = 254_016_000_000.0;
+const CW: u32 = 384;
+const CH: u32 = 216;
+const COLS: u32 = 5;
+
+type Res<T> = Result<T, Box<dyn std::error::Error>>;
+
+fn main() -> Res<()> {
+    let a: Vec<String> = std::env::args().skip(1).collect();
+    let usage = "usage: contact <out> <max_frames> <file>... | contact <out> range <file> <from> <to> <step> | contact <out> program <project.fcproj> <seconds>... | contact <out.png> frame <file> <seconds>";
+    let (Some(out), Some(mode), Some(arg)) = (a.first(), a.get(1), a.get(2)) else { return Err(usage.into()) };
+    let num = |i: usize| -> Res<f64> { Ok(a.get(i).ok_or(usage)?.parse::<f64>()?) };
+    let sheet_path = |name: &str| if out.ends_with(".jpg") { out.clone() } else { format!("{out}/{name}.jpg") };
+    let mut s = Session::default();
+    match mode.as_str() {
+        "program" => {
+            s.execute("file.open", json!({"path": arg}))?;
+            let times = a.get(3..).unwrap_or_default().iter().map(|t| t.parse()).collect::<Result<Vec<f64>, _>>()?;
+            sheet(&s, &times, &sheet_path("program"))?;
+        }
+        "frame" => {
+            open_clip(&mut s, arg)?;
+            let fr = s.try_render_program_at(1.0, Tick((num(3)? * TPS) as i64))?;
+            let rgb: Vec<u8> = fr.over_black_rgba8().as_chunks::<4>().0.iter().flat_map(|&[r, g, b, _]| [r, g, b]).collect();
+            image::RgbImage::from_raw(fr.w as u32, fr.h as u32, rgb).ok_or("frame")?.save(out)?;
+            println!("{}", json!({"frame": out, "w": fr.w, "h": fr.h}));
+        }
+        "range" => {
+            let (from, to, step) = (num(3)?, num(4)?, num(5)?.max(0.05));
+            let n = (((to - from) / step).floor() as usize + 1).clamp(1, 60);
+            open_clip(&mut s, arg)?;
+            let times: Vec<f64> = (0..n).map(|i| from + i as f64 * step).collect();
+            sheet(&s, &times, &sheet_path(&format!("{}_{from}-{to}", stem(arg))))?;
+        }
+        _ => {
+            let max: usize = mode.parse()?;
+            for f in a.get(2..).unwrap_or_default() {
+                let dur = open_clip(&mut s, f)?;
+                let n = max.min(((dur / 2.0) as usize).max(1));
+                let times: Vec<f64> = (0..n).map(|i| dur * (i as f64 + 0.5) / n as f64).collect();
+                sheet(&s, &times, &format!("{out}/{}.jpg", stem(f)))?;
+            }
+        }
+    }
+    Ok(())
+}
+
+fn stem(f: &str) -> String {
+    std::path::Path::new(f).file_stem().and_then(|x| x.to_str()).unwrap_or("clip").to_string()
+}
+
+/// Import a clip into a sequence of its own (placed whole at 0, so sequence time = source time); its length in seconds.
+fn open_clip(s: &mut Session, f: &str) -> Res<f64> {
+    let item = s.execute("file.import", json!({"paths": [f]}))?["items"][0].as_u64().ok_or("import failed")?;
+    s.execute("file.newSequence", json!({"name": stem(f), "fromItem": item}))?;
+    Ok(s.execute("sequence.inspect", json!({}))?["duration"].as_f64().ok_or("no duration")? / TPS)
+}
+
+/// Render the active sequence at `times` into one sheet; print path, times and levels.
+fn sheet(s: &Session, times: &[f64], path: &str) -> Res<()> {
+    let rows = (times.len() as u32).div_ceil(COLS).max(1);
+    let mut img = image::RgbImage::new(CW * COLS.min(times.len().max(1) as u32), CH * rows);
+    let mut levels = Vec::new();
+    for (i, t) in times.iter().enumerate() {
+        let fr = s.try_render_program_at(CW as f32 / 1920.0, Tick((t * TPS) as i64))?;
+        let rgb: Vec<u8> = fr.over_black_rgba8().as_chunks::<4>().0.iter().flat_map(|&[r, g, b, _]| [r, g, b]).collect();
+        levels.push(measure(&rgb));
+        let cell = image::RgbImage::from_raw(fr.w as u32, fr.h as u32, rgb).ok_or("frame")?;
+        let cell = image::imageops::resize(&cell, CW, CH, image::imageops::FilterType::Triangle);
+        image::imageops::overlay(&mut img, &cell, (i as u32 % COLS * CW) as i64, (i as u32 / COLS * CH) as i64);
+    }
+    img.save(path)?;
+    let times: Vec<f64> = times.iter().map(|t| (t * 100.0).round() / 100.0).collect();
+    println!("{}", json!({"sheet": path, "times": times, "levels": levels}));
+    Ok(())
+}
+
+/// Luma percentiles (Rec.709, %) and mean RGB of an 8-bit RGB frame.
+fn measure(rgb: &[u8]) -> Value {
+    let px = rgb.as_chunks::<3>().0;
+    let mut hist = [0u64; 256];
+    let mut sum = [0f64; 3];
+    for &[r, g, b] in px {
+        let y = 0.2126 * r as f64 + 0.7152 * g as f64 + 0.0722 * b as f64;
+        hist[(y.round() as usize).min(255)] += 1;
+        sum[0] += r as f64;
+        sum[1] += g as f64;
+        sum[2] += b as f64;
+    }
+    let n = px.len().max(1) as f64;
+    let pct = |p: f64| {
+        let mut acc = 0u64;
+        let target = (p * n) as u64;
+        let v = hist.iter().position(|&h| {
+            acc += h;
+            acc > target
+        });
+        (v.unwrap_or(255) as f64 / 2.55).round()
+    };
+    json!({"y2": pct(0.02), "y50": pct(0.5), "y98": pct(0.98), "rgb": sum.map(|c| (c / n).round())})
+}
